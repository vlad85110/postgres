diff --git a/src/backend/rest/rest_config.c b/src/backend/rest/rest_config.c
new file mode 100644
index 00000000000..b2f82b70b2c
--- /dev/null
+++ b/src/backend/rest/rest_config.c
@@ -0,0 +1,245 @@
+#include "rest/rest_config.h"
+#include "mb/pg_wchar.h"
+
+extern char *DataDir;
+#define BUF_SIZE 8192
+
+RestConfig rest_config;
+
+static const char *
+json_error_name(JsonParseErrorType err)
+{
+    switch (err)
+    {
+        case JSON_SUCCESS:                  return "JSON_SUCCESS";
+        case JSON_INCOMPLETE:               return "JSON_INCOMPLETE";
+        case JSON_INVALID_LEXER_TYPE:       return "JSON_INVALID_LEXER_TYPE";
+        case JSON_NESTING_TOO_DEEP:         return "JSON_NESTING_TOO_DEEP";
+        case JSON_ESCAPING_INVALID:         return "JSON_ESCAPING_INVALID";
+        case JSON_ESCAPING_REQUIRED:        return "JSON_ESCAPING_REQUIRED";
+        case JSON_EXPECTED_ARRAY_FIRST:     return "JSON_EXPECTED_ARRAY_FIRST";
+        case JSON_EXPECTED_ARRAY_NEXT:      return "JSON_EXPECTED_ARRAY_NEXT";
+        case JSON_EXPECTED_COLON:           return "JSON_EXPECTED_COLON";
+        case JSON_EXPECTED_END:             return "JSON_EXPECTED_END";
+        case JSON_EXPECTED_JSON:            return "JSON_EXPECTED_JSON";
+        case JSON_EXPECTED_MORE:            return "JSON_EXPECTED_MORE";
+        case JSON_EXPECTED_OBJECT_FIRST:    return "JSON_EXPECTED_OBJECT_FIRST";
+        case JSON_EXPECTED_OBJECT_NEXT:     return "JSON_EXPECTED_OBJECT_NEXT";
+        case JSON_EXPECTED_STRING:          return "JSON_EXPECTED_STRING";
+        case JSON_INVALID_TOKEN:            return "JSON_INVALID_TOKEN";
+        case JSON_OUT_OF_MEMORY:            return "JSON_OUT_OF_MEMORY";
+        case JSON_UNICODE_CODE_POINT_ZERO:  return "JSON_UNICODE_CODE_POINT_ZERO";
+        case JSON_UNICODE_ESCAPE_FORMAT:    return "JSON_UNICODE_ESCAPE_FORMAT";
+        case JSON_UNICODE_HIGH_ESCAPE:      return "JSON_UNICODE_HIGH_ESCAPE";
+        case JSON_UNICODE_UNTRANSLATABLE:   return "JSON_UNICODE_UNTRANSLATABLE";
+        case JSON_UNICODE_HIGH_SURROGATE:   return "JSON_UNICODE_HIGH_SURROGATE";
+        case JSON_UNICODE_LOW_SURROGATE:    return "JSON_UNICODE_LOW_SURROGATE";
+        case JSON_SEM_ACTION_FAILED:        return "JSON_SEM_ACTION_FAILED";
+    }
+    return "UNKNOWN";
+}
+
+static ssize_t
+read_file_to_buffer(const char *path, char *buffer, size_t buf_size)
+{
+    FILE *file;
+    ssize_t bytes_read;
+
+    file = fopen(path, "r");
+    if (file == NULL)
+    {
+        elog(WARNING, "rest: cannot open config file: %s %m", path);
+        return -1;
+    }
+
+    bytes_read = fread(buffer, 1, buf_size - 1, file);
+    if (bytes_read == buf_size - 1 && fgetc(file) != EOF)
+    {
+        fclose(file);
+        elog(WARNING, "rest: config file %s is too large", path);
+        return -1;
+    }
+    fclose(file);
+    if (bytes_read == 0)
+    {
+        elog(WARNING, "rest: cannot read config file: %s %m", path);
+        return -1;
+    }
+
+    buffer[bytes_read] = '\0';
+
+    return bytes_read;
+}
+
+static void
+build_path(const char *path, char *f_path, size_t size)
+{
+    if (path[0] == '/')
+    {
+        strlcpy(f_path, path, size);
+    }
+    else
+    {
+        snprintf(f_path, size, "%s/%s", DataDir, path);
+    }
+}
+
+static bool
+is_duplicate_field(const char *process_name)
+{
+    for (int i = 0; i < rest_config.count; i++)
+    {
+        if (strcmp(rest_config.entries[i].process_name, process_name) == 0)
+        {
+            elog(WARNING, "rest: field \"%s\" is duplicated", process_name);
+            return true;
+        }
+    }
+    return false;
+}
+
+static void
+add_config_entry(const char *process_name, char *token)
+{
+    RestConfigEntry *entry = &rest_config.entries[rest_config.count];
+
+    strlcpy(entry->process_name, process_name, sizeof(entry->process_name));
+    entry->port = atoi(token);
+    rest_config.count++;
+}
+
+static JsonParseErrorType
+rest_object_start(void *pstate)
+{
+    RestParseState *state = (RestParseState *)pstate;
+    state->depth++;
+
+    return JSON_SUCCESS;
+}
+
+static JsonParseErrorType
+rest_object_end(void *pstate)
+{
+    RestParseState *state = (RestParseState *)pstate;
+    state->depth--;
+
+    if (state->ports_depth > state->depth)
+    {
+        state->ports_depth = 0;
+    }
+
+    return JSON_SUCCESS;
+}
+
+static JsonParseErrorType
+rest_object_field_start(void *pstate, char *fname, bool isnull)
+{
+    RestParseState *state = (RestParseState *)pstate;
+
+    if (fname == NULL)
+    {
+        return JSON_SUCCESS;
+    }
+
+    if (state->ports_depth == 0)
+    {
+        if (strcmp(fname, "ports") == 0)
+        {
+            state->ports_depth = state->depth + 1;
+        }
+    }
+    else if (state->depth == state->ports_depth)
+    {
+        strlcpy(state->process_name, fname, sizeof(state->process_name));
+    }
+
+    return JSON_SUCCESS;
+}
+
+static JsonParseErrorType
+rest_object_field_end(void *pstate, char *fname, bool isnull)
+{
+    RestParseState *state = (RestParseState *)pstate;
+    state->process_name[0] = '\0';
+
+    return JSON_SUCCESS;
+}
+
+static JsonParseErrorType
+rest_scalar(void *pstate, char *token, JsonTokenType tokentype)
+{
+    RestParseState *state = (RestParseState *)pstate;
+
+    if (state->ports_depth == 0 || state->depth != state->ports_depth || tokentype != JSON_TOKEN_NUMBER)
+    {
+        return JSON_SUCCESS;
+    }
+
+    if (rest_config.count >= MAX_CONFIG_ENTRIES)
+    {
+        return JSON_SUCCESS;
+    }
+
+    if (is_duplicate_field(state->process_name))
+    {
+        return JSON_SUCCESS;
+    }
+
+    add_config_entry(state->process_name, token);
+
+    return JSON_SUCCESS;
+}
+
+JsonParseErrorType
+rest_config_parse(const char *path)
+{
+    char buffer[BUF_SIZE];
+    char f_path[MAXPGPATH];
+    JsonSemAction sem = {0};
+    RestParseState state = {0};
+    JsonLexContext lex;
+    JsonParseErrorType result;
+
+    if (path == NULL || path[0] == '\0')
+    {
+        return JSON_SUCCESS;
+    }
+    build_path(path, f_path, sizeof(f_path));
+
+    if (read_file_to_buffer(f_path, buffer, sizeof(buffer)) < 0)
+    {
+        return JSON_INVALID_TOKEN;
+    }
+
+    sem.object_start = rest_object_start;
+    sem.object_end = rest_object_end;
+    sem.object_field_start = rest_object_field_start;
+    sem.object_field_end = rest_object_field_end;
+    sem.scalar = rest_scalar;
+    sem.semstate = &state;
+
+    makeJsonLexContextCstringLen(&lex, buffer, strlen(buffer), PG_UTF8, true);
+
+    result = pg_parse_json(&lex, &sem);
+    if (result != JSON_SUCCESS)
+    {
+        elog(WARNING, "rest: json parse error: %s", json_error_name(result));
+        rest_config.count = 0;
+        memset(rest_config.entries, 0, sizeof(rest_config.entries));
+    }
+
+    return result;
+}
+
+int
+rest_config_get_port(const char *process_name)
+{
+    for (int i = 0; i < rest_config.count; i++)
+    {
+        if (strcmp(rest_config.entries[i].process_name, process_name) == 0)
+        {
+            return rest_config.entries[i].port;
+        }
+    }
+    return -1;
+}
diff --git a/src/backend/rest/rest_server.c b/src/backend/rest/rest_server.c
new file mode 100644
index 00000000000..7f93fa96eee
--- /dev/null
+++ b/src/backend/rest/rest_server.c
@@ -0,0 +1,417 @@
+#include "rest/rest_server.h"
+#include "rest/rest_config.h"
+#include "utils/memutils.h"
+#include <sys/socket.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <unistd.h>
+#include <arpa/inet.h>
+#include <string.h>
+#include "miscadmin.h"
+#include "replication/walsender.h"
+#include "replication/walsender_private.h"
+#include "utils/guc.h"
+
+char *rest_config_file = NULL;
+extern int PostPortNumber;
+
+RestServer *rest_server = NULL;
+
+const char *
+get_process_name(int child_type)
+{
+    switch (child_type)
+    {
+        case B_WAL_RECEIVER:    return "walreceiver";
+        case B_WAL_SENDER:      return "walsender";
+        case B_WAL_WRITER:      return "walwriter";
+        case B_BG_WRITER:       return "bgwriter";
+        case B_CHECKPOINTER:    return "checkpointer";
+        case B_AUTOVAC_LAUNCHER:return "autovacuum";
+        default:                return  NULL;
+    }
+}
+
+static int
+get_port(int child_type, const char *proc_name)
+{
+    int port = rest_config_get_port(proc_name);
+
+    if (port == -1)
+    {
+        return -1;
+    }
+
+    if (child_type == B_WAL_SENDER)
+    {
+        port += MyWalSnd - WalSndCtl->walsnds;
+    }
+
+    if (port < 1024 || port > 65535)
+    {
+        elog(WARNING, "rest: on %s port %d is out of range 1024-65535", proc_name, port);
+        return -1;
+    }
+
+    return port;
+}
+
+void
+register_endpoint(RestServer *server, const char *url, endpoint_handler handler, void *user_data)
+{
+    if (server == NULL)
+    {
+        return;
+    }
+
+    if (server->endpoints_count < MAX_ENDPOINTS)
+    {
+        server->endpoints[server->endpoints_count].url = url;
+        server->endpoints[server->endpoints_count].handler = handler;
+        server->endpoints[server->endpoints_count].user_data = user_data;
+        server->endpoints_count++;
+    }
+}
+
+RestServer *
+rest_init(int child_type)
+{
+    RestServer *server;
+    int port;
+    int flags;
+    const char *proc_name;
+    struct sockaddr_in server_addr;
+
+    proc_name = get_process_name(child_type);
+    if (proc_name == NULL)
+    {
+        return NULL;
+    }
+
+    port = get_port(child_type, proc_name);
+    if (port == -1)
+    {
+        return NULL;
+    }
+
+    server = palloc0(sizeof(RestServer));
+    server->server_socket = -1;
+    server->port = port;
+    server->event_set = NULL;
+    server->need_recreate = false;
+    server->endpoints_count = 0;
+    memset(server->clients, 0, sizeof(server->clients));
+
+    if ((server->server_socket = socket(AF_INET, SOCK_STREAM, 0)) < 0)
+    {
+        elog(WARNING, "rest: socket error: %m");
+        pfree(server);
+        return NULL;
+    }
+
+    flags = fcntl(server->server_socket, F_GETFL, 0);
+    fcntl(server->server_socket, F_SETFL, flags | O_NONBLOCK);
+
+    memset(&server_addr, 0, sizeof(server_addr));
+    server_addr.sin_family = AF_INET;
+    server_addr.sin_port = htons(port);
+    server_addr.sin_addr.s_addr = htonl(INADDR_ANY);
+
+    if (bind(server->server_socket, (struct sockaddr*)&server_addr, sizeof(server_addr)) < 0)
+    {
+        elog(WARNING, "rest: bind error: %m");
+        close(server->server_socket);
+        server->server_socket = -1;
+        pfree(server);
+        return NULL;
+    }
+
+    listen(server->server_socket, 100);
+
+    server->event_set = CreateWaitEventSet(NULL, MAX_CLIENTS + 1);
+
+    AddWaitEventToSet(server->event_set, WL_SOCKET_READABLE, server->server_socket, NULL, NULL);
+
+    elog(LOG, "rest: server started in %s on port %d", proc_name, port);
+
+    return server;
+}
+
+static void
+close_slot(RestServer *server, int slot)
+{
+    if (server->clients[slot].fd >= 0)
+    {
+        close(server->clients[slot].fd);
+    }
+    server->clients[slot].active = false;
+    server->clients[slot].fd = -1;
+    server->need_recreate = true;
+}
+
+static int
+find_free_slot(RestServer *server)
+{
+    for (int i = 0; i < MAX_CLIENTS; i++)
+    {
+        if (!server->clients[i].active)
+        {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static int
+find_slot(RestServer *server, int fd)
+{
+    for (int i = 0; i < MAX_CLIENTS; i++)
+    {
+        if (server->clients[i].active && server->clients[i].fd == fd)
+        {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static void
+rest_recreate_event_set(RestServer *server)
+{
+    FreeWaitEventSet(server->event_set);
+    server->event_set = CreateWaitEventSet(NULL, MAX_CLIENTS + 1);
+    AddWaitEventToSet(server->event_set, WL_SOCKET_READABLE, server->server_socket, NULL, NULL);
+
+    for (int i = 0; i < MAX_CLIENTS; i++)
+    {
+        if (server->clients[i].active)
+        {
+            AddWaitEventToSet(server->event_set, WL_SOCKET_READABLE | WL_SOCKET_WRITEABLE, server->clients[i].fd, NULL, NULL);
+        }
+    }
+
+    server->need_recreate = false;
+}
+
+static void
+rest_connection_accept(RestServer *server)
+{
+    int slot;
+    int client_flags;
+    int client_socket = accept(server->server_socket, NULL, NULL);
+
+    if (client_socket < 0)
+    {
+        if (errno == EAGAIN || errno == EWOULDBLOCK)
+        {
+            return;
+        }
+        elog(WARNING, "rest: accept error: %m");
+        return;
+    }
+
+    slot = find_free_slot(server);
+
+    if (slot == -1) {
+        elog(WARNING, "rest: too many requests, try again later");
+        close(client_socket);
+        return;
+    }
+
+    server->clients[slot].active = true;
+    server->clients[slot].fd = client_socket;
+    server->clients[slot].read_pos = 0;
+    server->clients[slot].response_ready = false;
+    server->clients[slot].response_len = 0;
+    server->clients[slot].written = 0;
+    memset(server->clients[slot].read_buffer, 0, sizeof(server->clients[slot].read_buffer));
+    memset(server->clients[slot].response, 0, sizeof(server->clients[slot].response));
+
+    client_flags = fcntl(server->clients[slot].fd, F_GETFL, 0);
+    fcntl(server->clients[slot].fd, F_SETFL, client_flags | O_NONBLOCK);
+
+    AddWaitEventToSet(server->event_set, WL_SOCKET_READABLE | WL_SOCKET_WRITEABLE, server->clients[slot].fd, NULL, NULL);
+
+    elog(DEBUG1, "rest: new connection accepted fd: %d, position: %d", client_socket, slot);
+}
+
+static bool
+rest_find_endpoint(RestServer *server, const char *url, const char *method, const char *body, Response *response)
+{
+    Request request = {method, body, url, NULL};
+    for (int i = 0; i < server->endpoints_count; i++)
+    {
+        if (strcmp(url, server->endpoints[i].url) == 0)
+        {
+            request.user_data = server->endpoints[i].user_data;
+            server->endpoints[i].handler(&request, response);
+            return true;
+        }
+    }
+    return false;
+}
+
+static void
+rest_build_response(Client *client, Response *response)
+{
+    snprintf(client->response, sizeof(client->response),
+            "HTTP/1.1 %d %s\r\n"
+            "Content-Type: %s\r\n"
+            "Content-Length: %zu\r\n"
+            "\r\n"
+            "%s",
+            response->status_code,
+            response->status_text,
+            response->content_type,
+            strlen(response->body), response->body);
+
+    client->response_len = strlen(client->response);
+    client->written = 0;
+    client->response_ready = true;
+    elog(DEBUG1, "rest: response ready (%zu bytes), waiting for write", client->response_len);
+}
+
+static void
+rest_handle_request(RestServer *server, Client *client, int slot)
+{
+    char method[16], url[256];
+    Response response = {200, "OK", "application/json", ""};
+    char *request_body;
+    const char *error_body;
+    ssize_t bytes_read = read(client->fd, client->read_buffer + client->read_pos, 
+                                          sizeof(client->read_buffer) - client->read_pos - 1);
+    if (bytes_read < 0) {
+        if (errno == EAGAIN || errno == EWOULDBLOCK)
+        {
+            return;
+        }
+        elog(WARNING, "rest: read error: %m");
+        close_slot(server, slot);
+        return;
+    }
+    else if (bytes_read == 0) {
+        elog(DEBUG1, "rest: client closed connection");
+        close_slot(server, slot);
+        return;
+    }
+
+    client->read_pos += bytes_read;
+    client->read_buffer[client->read_pos] = '\0';
+
+    elog(DEBUG1, "rest: read %zd bytes, read %zu bytes in total", bytes_read, client->read_pos);
+
+    if (strstr(client->read_buffer, "\r\n\r\n") == NULL)
+    {
+        return;
+    }
+
+    if (sscanf(client->read_buffer, "%15s %255s", method, url) != 2)
+    {
+        response.status_code = 400;
+        response.status_text = "Bad Request";
+        response.content_type = "text/plain";
+        snprintf(response.body, sizeof(response.body), "Bad Request\n");
+        rest_build_response(client, &response);
+        return;
+    }
+
+    request_body = strstr(client->read_buffer, "\r\n\r\n");
+    if (request_body)
+    {
+        request_body += 4;
+    }
+
+    if (rest_find_endpoint(server, url, method, request_body, &response))
+    {
+        rest_build_response(client, &response);
+    }
+
+    else
+    {
+        response.status_code = 404;
+        response.status_text = "NotFound";
+        response.content_type = "text/plain";
+        error_body = "Invalid request.\n"
+                "Try: \ncurl -X <method> http:/<host>:<port>/<endpoint> -H <headers> -d <body>\n\n"
+                "example:\n"
+                "curl -X POST http:/localhost:8080/value/set "
+                "-H 'Content-Type: application/json' "
+                "-d '{\"value\": 300}'\n";
+
+        snprintf(response.body, sizeof(response.body), "%s", error_body);
+        rest_build_response(client, &response);
+    }
+}
+
+static void
+rest_handle_response(RestServer *server, Client *client, int slot)
+{
+    size_t remaining = client->response_len - client->written;
+    ssize_t bytes_written = write(client->fd, client->response + client->written, remaining);
+
+    if (bytes_written < 0)
+    {
+        if (errno == EAGAIN || errno == EWOULDBLOCK)
+        {
+            return;
+        }
+        elog(WARNING, "rest: write error: %m");
+        close_slot(server, slot);
+        return;
+    }
+    client->written += bytes_written;
+    elog(DEBUG1, "rest: %zd bytes written, %zu/%zu total", bytes_written, client->written, client->response_len);
+
+    if (client->written >= client->response_len){
+        elog(DEBUG1, "rest: response sent completely");
+        close_slot(server, slot);
+    }
+}
+
+void
+rest_server_poll(RestServer *server)
+{
+    int number_of_fd;
+    int slot;
+    Client *client;
+    WaitEvent events[MAX_CLIENTS + 1];
+
+    if (server == NULL || server->server_socket < 0 || server->event_set == NULL)
+    {
+        return;
+    }
+
+    if (server->need_recreate)
+    {
+        rest_recreate_event_set(server);
+    }
+
+    number_of_fd = WaitEventSetWait(server->event_set, 0, events, MAX_CLIENTS + 1, 0);
+
+    for (int i = 0; i < number_of_fd; i++)
+    {
+        if (events[i].fd == server->server_socket)
+        {
+            rest_connection_accept(server);
+            continue;
+        }
+
+        slot = find_slot(server, events[i].fd);
+        if (slot == -1) {
+            elog(WARNING, "rest: client not found");
+            continue;
+        }
+
+        client = &server->clients[slot];
+
+        if (events[i].events & WL_SOCKET_READABLE && !client->response_ready)
+        {
+            rest_handle_request(server, client, slot);
+        }
+
+        if (events[i].events & WL_SOCKET_WRITEABLE && client->response_ready)
+        {
+            rest_handle_response(server, client, slot);
+        }
+    }
+}
